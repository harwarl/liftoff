# Full WS URL (takes precedence), or just the key and the default PONS endpoint is used.
PUMP_DEV_URL=
PUMPDEV_KEY=

# Leave either empty for dry-run: rendered posts are logged instead of sent.
TG_BOT_TOKEN=
TG_CHANNEL_ID=-100...

RUST_LOG=info

# Robinhood Chain JSON-RPC, used to read name/symbol of a graduated token at post time.
# Defaults to the public https://rpc.mainnet.chain.robinhood.com.
RPC_URL=
